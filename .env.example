# NeuroNose Environment Configuration
# Copy this file to .env and adjust values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=neuronose
POSTGRES_USER=neuronose
POSTGRES_PASSWORD=changeme_dev_only

# Java Backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
NEURONOSE_DEMO_MODE=true

# Python ML Service
ML_SERVICE_PORT=5000
ML_MODEL_DIR=./python-ml/models

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEMO_MODE=true
